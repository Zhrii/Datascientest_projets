# Container "train" (Pipeline Runner) : lance le pipeline ZenML
# preprocess_data -> train_model -> promote_model
# C'est un "job" : il fait son travail puis il s'arrête.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MLFLOW_DISABLE_TELEMETRY=true

# les librairies d'abord (cache Docker)
COPY requirements-train.txt ./
RUN pip install --no-cache-dir -r requirements-train.txt

RUN python -c "import nltk; nltk.download('stopwords', quiet=True)"

# le code seulement. Données et modèles sont branchés au lancement.
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY pipelines/ ./pipelines/

# "data brut" a un espace dans son nom, donc on le branche sous /app/data_brut
ENV DATA_BRUT_DIR=/app/data_brut MODELS_DIR=/app/models
CMD ["python", "pipelines/rakuten_pipeline.py"]

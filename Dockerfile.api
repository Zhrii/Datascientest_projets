# Container "api" : donne les prédictions du modèle texte
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# on installe d'abord les librairies (Docker les garde en cache,
# les prochains builds seront beaucoup plus rapides)
COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# stopwords français, téléchargés pendant le build
RUN python -c "import nltk; nltk.download('stopwords', quiet=True)"

# le code seulement. Les modèles ne sont PAS copiés dans l'image :
# ils sont branchés au lancement (voir docker-compose.yml)
COPY src/ ./src/
COPY api/ ./api/

EXPOSE 8000

# Docker vérifie que l'API répond bien sur /health
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]

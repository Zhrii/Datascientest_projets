# Container "api" (et "streamlit") : prédictions texte / image / fusion
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    MODELS_DIR=/app/models \
    MLFLOW_DISABLE_TELEMETRY=true

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential \
    && rm -rf /var/lib/apt/lists/*

# les librairies d'abord (cache Docker)
COPY requirements-api.txt requirements-test.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt -r requirements-test.txt \
    && python -c "import nltk; nltk.download('stopwords', quiet=True)" \
    && (python -m spacy download fr_core_news_sm || true)

# le code seulement. Données, modèles et images sont branchés au lancement.
# scripts/ + pipelines/ servent à POST /retrain (même pipeline que le container train)
COPY api ./api
COPY src ./src
COPY scripts ./scripts
COPY pipelines ./pipelines
COPY tests ./tests
COPY pytest.ini ./
COPY app.py ./

RUN mkdir -p models artifacts data data_brut .cache/huggingface

EXPOSE 8000 8501

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
